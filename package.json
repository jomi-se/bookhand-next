{
  "name": "bookhand",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "fixtures:generate": "node scripts/generate-epub-fixtures.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && npm run verify:bundle && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:index-harness": "vite build --mode test-harness && BOOKHAND_TEST_HARNESS=1 playwright test tests/e2e/index-lifecycle.spec.ts",
    "test:e2e:tutor-harness": "vite build --mode test-harness && BOOKHAND_TEST_HARNESS=1 playwright test tests/e2e/tutor-guidance.spec.ts --project=chromium",
    "typecheck": "tsc -b --pretty false",
    "verify:bundle": "node scripts/verify-production-bundle.mjs",
    "verify:ai-sdk": "node scripts/verify-ai-sdk-packaging.mjs",
    "verify:csp": "node scripts/verify-production-csp.mjs",
    "verify:setup": "node scripts/verify-agent-setup.mjs",
    "check:live": "node scripts/check-live-webmcp.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:bundle && npm run verify:ai-sdk && npm run verify:csp && npm run test:e2e:built && npm run verify:setup",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:dry": "npm run build && npx wrangler deploy --dry-run",
    "serve:tailnet": "npm run build && npx vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@ai-sdk/open-responses": "2.0.39",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@open-agent-connect/web": "0.0.9",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "ai": "7.0.93",
    "construct-style-sheets-polyfill": "^3.1.0",
    "foliate-js": "https://github.com/jomi-se/foliate-js/archive/ca3f118269f8d78811ef17a1b147363c321273d7.tar.gz",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "patch-package": "8.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  }
}
